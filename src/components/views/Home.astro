---
import ArchiveTerminal from "../archive/ArchiveTerminal.astro";
import PortfolioOverview from "../portfolio/PortfolioOverview.astro";
import { archiveManifest } from "../../lib/archive-manifest";
import { pagePath, type Locale } from "../../lib/routes";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const files = await archiveManifest(locale);
---

<ArchiveTerminal locale={locale} portfolios={files} />
<section
  class="archive-fallback simple-portfolio"
  id="archive-index"
  tabindex="-1"
>
  <nav
    class="simple-collection-links"
    aria-label={locale === "en" ? "Collections" : "档案分类"}
  >
    {files.map((file) => (
      <a href={file.href}>{file.title} ↗</a>
    ))}
    <a href={pagePath("publications", locale)}>
      {locale === "en" ? "Publications" : "论文目录"} ↗
    </a>
  </nav>
  <PortfolioOverview locale={locale} kind="academic" displaySwitch={false} />
</section>

<style>
  .simple-collection-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 14px;
    padding-top: 20px;
  }
</style>
