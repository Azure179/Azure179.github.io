---
import { pagePath, type Locale } from "../../lib/routes";
import { ui } from "../../i18n/ui";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
---

<footer class="site-footer">
  <div class="footer-main">
    <div>
      <p class="eyebrow">BIOINFORMATICS ARCHIVE</p>
      <p class="footer-statement">{t.footer}</p>
    </div>
    <nav
      class="footer-links"
      aria-label={locale === "en" ? "Footer" : "页脚导航"}
    >
      <a href={pagePath("cv", locale)}>
        {t.cv} <span aria-hidden="true">↗</span>
      </a>
      <a href={pagePath("contact", locale)}>
        {t.contact} <span aria-hidden="true">↗</span>
      </a>
      <a href={pagePath("credits", locale)}>{t.credits}</a>
    </nav>
  </div>
  <div class="footer-meta">
    <span>{t.footerNote}</span>
    <a href="#top">{t.footerTop} ↑</a>
  </div>
</footer>
