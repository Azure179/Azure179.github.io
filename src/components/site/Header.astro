---
import {
  pagePath,
  oppositeLocale,
  type Locale,
  type PageKey,
} from "../../lib/routes";
import { ui } from "../../i18n/ui";
import ContactPanel from "./ContactPanel.astro";
interface Props {
  locale: Locale;
  page: PageKey;
  switchHref?: string;
  switchFallback?: boolean;
}
const { locale, page, switchHref, switchFallback = false } = Astro.props;
const t = ui(locale);
const navigation: PageKey[] = [
  "home",
  "academic",
  "technical",
  "about",
  "contact",
];
const activePage =
  page === "research" || page === "publications"
    ? "academic"
    : page === "projects"
      ? "technical"
      : page;
const languageHref = switchHref ?? pagePath(page, oppositeLocale(locale));
---

<header class="site-header" id="top">
  <a
    class="brand"
    href={pagePath("home", locale)}
    aria-label="Bioinformatics Archive — Home"
  >
    <span class="brand-mark" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span>
      BIOINFORMATICS
      <br />
      <strong>ARCHIVE</strong>
    </span>
  </a>
  {page !== "home" && (
    <nav class="desktop-nav" aria-label={t.menu}>
      {navigation.map((item) => (
        <a
          href={pagePath(item, locale)}
          aria-current={activePage === item ? "page" : undefined}
        >
          {t[item]}
        </a>
      ))}
    </nav>
  )}
  <div class="header-tools">
    <a
      class="language-link"
      href={languageHref}
      lang={locale === "en" ? "zh-CN" : "en"}
      aria-label={
        switchFallback
          ? t.translationMissing
          : `${t.language}: ${locale === "en" ? "中文" : "English"}`
      }
    >
      <span aria-hidden="true">◎</span> {locale === "en" ? "中文" : "EN"}
    </a>
    {page === "home" ? (
      <ContactPanel locale={locale} />
    ) : (
      <details class="mobile-menu">
        <summary>
          {t.menu} <span aria-hidden="true">＋</span>
        </summary>
        <nav aria-label={t.menu}>
          {[...navigation, "cv" as const].map((item) => (
            <a
              href={pagePath(item, locale)}
              aria-current={activePage === item ? "page" : undefined}
            >
              {t[item]} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </details>
    )}
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  menu?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (
      menu?.open &&
      event.target instanceof Node &&
      !menu.contains(event.target)
    )
      menu.open = false;
  });
</script>
