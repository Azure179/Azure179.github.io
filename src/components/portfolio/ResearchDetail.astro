---
import type { CollectionEntry } from "astro:content";
import "../../styles/portfolio.css";
import { allPublished } from "../../lib/content";
import { resolvePublications } from "../../lib/publication-links";
import { entryPath } from "../../lib/routes";
import { portfolioHeadings } from "../../data/portfolio";
import FigureGallery from "./FigureGallery.astro";
interface Props {
  entry: CollectionEntry<"research">;
}
const { entry } = Astro.props;
const { study, locale, figures } = entry.data;
if (!study) throw new Error("Research details require study data");
const headings = portfolioHeadings("research", locale).filter(
  ({ id }) => id !== "findings" || study.findings.length > 0,
);
const papers = resolvePublications(
  await allPublished(),
  study.publicationIds,
  locale,
).filter(
  (item): item is CollectionEntry<"publications"> =>
    item.collection === "publications",
);
const en = locale === "en";
---

{headings.map(({ id, text }) => (
  <section id={id}>
    <h2>{text}</h2>
    {(["overview", "background", "design", "analysis"] as const).map(
      (key) => key === id && study[key].map((paragraph) => <p>{paragraph}</p>),
    )}
    {id !== "figures" && figures.some((figure) => figure.placement === id) && (
      <FigureGallery
        figures={figures.filter((figure) => figure.placement === id)}
        locale={locale}
      />
    )}
    {id === "findings" &&
      study.findings.map((finding) => <p>{finding.text}</p>)}
    {id === "figures" && (
      <FigureGallery
        figures={figures.filter((figure) => figure.placement === "figures")}
        locale={locale}
      />
    )}
    {id === "publications" &&
      (papers.length ? (
        <ul>
          {papers.map((paper) => (
            <li>
              <a
                href={entryPath(
                  "publications",
                  paper.data.slug,
                  paper.data.locale,
                )}
              >
                {paper.data.originalTitle}
              </a>
              <p>
                {paper.data.authors.join(", ")} · {paper.data.venue} ·{" "}
                {paper.data.year}
              </p>
              {paper.data.citationNote && <p>{paper.data.citationNote}</p>}
              {paper.data.doi && (
                <a
                  href={`https://doi.org/${paper.data.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  DOI: {paper.data.doi}
                </a>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="pending-note">
          {en ? "No publications listed." : "暂无公开论文。"}
        </p>
      ))}
    {id === "publications" && entry.data.links.length > 0 && (
      <ul>
        {entry.data.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label} ↗
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
))}
