---
import type { CollectionEntry } from "astro:content";
import "../../styles/portfolio.css";
import { portfolioHeadings } from "../../data/portfolio";
import FigureGallery from "./FigureGallery.astro";
interface Props {
  entry: CollectionEntry<"software">;
}
const { entry } = Astro.props;
const { caseStudy, locale, figures, stack, links } = entry.data;
if (!caseStudy) throw new Error("Technical details require case study data");
const headings = portfolioHeadings("software", locale);
---

{headings.map(({ id, text }) => (
  <section id={id}>
    <h2>{text}</h2>
    {(
      [
        "overview",
        "solution",
        "architecture",
        "implementation",
        "validation",
      ] as const
    ).map(
      (key) =>
        key === id && caseStudy[key].map((paragraph) => <p>{paragraph}</p>),
    )}
    {id !== "figures" && figures.some((figure) => figure.placement === id) && (
      <FigureGallery
        figures={figures.filter((figure) => figure.placement === id)}
        locale={locale}
      />
    )}
    {id === "stack" && (
      <ul class="stack-list">
        {stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )}
    {id === "implementation" && (
      <figure class="workflow-figure">
        <ol>
          {caseStudy.workflow.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </figure>
    )}
    {id === "figures" && (
      <>
        {entry.data.translationKey === "llm-rnaseq-platform" && (
          <p>{caseStudy.galleryNote}</p>
        )}
        <FigureGallery
          figures={figures.filter((figure) => figure.placement === "figures")}
          locale={locale}
        />
      </>
    )}
    {id === "links" && (
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.url}>{link.label} ↗</a>
          </li>
        ))}
      </ul>
    )}
  </section>
))}
