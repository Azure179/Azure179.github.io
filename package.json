{
  "name": "bioinformatics-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write src scripts tests astro.config.mjs package.json tsconfig.json",
    "format:check": "prettier --check src scripts tests astro.config.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "tailwindcss": "4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  }
}
